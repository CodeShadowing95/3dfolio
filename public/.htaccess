# Cache du site sur l'hébergeur (Apache / LiteSpeed chez Hostinger)
# Les pages HTML sont toujours revérifiées : après un déploiement, les visiteurs voient tout de suite la nouvelle version.
# Les fichiers de _next/static ont un nom qui change à chaque build : ils peuvent rester en cache un an.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|mp4|webm|woff2|glb|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Cache serveur LiteSpeed : désactivé pour les pages HTML (sinon l'ancien site peut rester servi)
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

# Page 404 du site
ErrorDocument 404 /404.html
